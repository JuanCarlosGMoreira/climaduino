#include <DHT.h>
#include <SoftwareSerial.h>

#define DHTPIN1 2
#define DHTPIN2 3
#define DHTTYPE DHT11

#define LED_PIN 8
#define LIMITE_TEMPERATURA 30.0

DHT sensor1(DHTPIN1, DHTTYPE);
DHT sensor2(DHTPIN2, DHTTYPE);

SoftwareSerial bluetooth(10, 11);

void setup() {
  Serial.begin(9600);
  bluetooth.begin(9600);

  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);

  sensor1.begin();
  sensor2.begin();

  Serial.println("Sistema iniciado!");
  bluetooth.println("Sistema iniciado!");
}

void loop() {
  float t1 = sensor1.readTemperature();
  float u1 = sensor1.readHumidity();

  float t2 = sensor2.readTemperature();
  float u2 = sensor2.readHumidity();

  if (isnan(t1) || isnan(u1) ||
      isnan(t2) || isnan(u2)) {

    digitalWrite(LED_PIN, LOW);

    Serial.println("Erro na leitura dos sensores!");
    bluetooth.println("Erro na leitura dos sensores!");

    delay(2500);
    return;
  }

  float mediaTemp = (t1 + t2) / 2.0;
  float mediaUmid = (u1 + u2) / 2.0;

  float diferenca = abs(t1 - t2);

  bool alerta = (t1 > LIMITE_TEMPERATURA ||
                 t2 > LIMITE_TEMPERATURA);

  digitalWrite(LED_PIN, alerta ? HIGH : LOW);

  String status = alerta ? "ALERTA!" : "NORMAL";

  Serial.println("----------------------------");
  Serial.println("MONITORAMENTO DA SALA");

  Serial.print("Sensor 1: ");
  Serial.print(t1);
  Serial.print(" C | Umidade: ");
  Serial.print(u1);
  Serial.println(" %");

  Serial.print("Sensor 2: ");
  Serial.print(t2);
  Serial.print(" C | Umidade: ");
  Serial.print(u2);
  Serial.println(" %");

  Serial.print("Temperatura media: ");
  Serial.print(mediaTemp);
  Serial.println(" C");
  Serial.print("Umidade media: ");
  Serial.print(mediaUmid);
  Serial.println(" %");
  Serial.print("Diferenca de temperatura: ");
  Serial.print(diferenca);
  Serial.println(" C");

  Serial.print("Status: ");
  Serial.println(status);

  bluetooth.print("T1:");
  bluetooth.print(t1);
  bluetooth.print(";U1:");
  bluetooth.print(u1);

  bluetooth.print(";T2:");
  bluetooth.print(t2);
  bluetooth.print(";U2:");
  bluetooth.print(u2);

  bluetooth.print(";MEDIA:");
  bluetooth.print(mediaTemp);

  bluetooth.print(";UMIDADE:");
  bluetooth.print(mediaUmid);

  bluetooth.print(";DIFERENCA:");
  bluetooth.print(diferenca);

  bluetooth.print(";STATUS:");
  bluetooth.println(status);

  delay(2500);
}
